# .bashrc

# Source fzf keybindings and completion (distro-agnostic)
for fzf_path in /usr/share/fzf /usr/share/doc/fzf/examples /opt/homebrew/opt/fzf/shell; do
    [ -f "$fzf_path/key-bindings.bash" ] && source "$fzf_path/key-bindings.bash"
    [ -f "$fzf_path/completion.bash" ] && source "$fzf_path/completion.bash"
done

# Import "fzf" configuration variables
if [[ -f ${HOME}/.config/fzf/config ]]; then
  . ${HOME}/.config/fzf/config
fi

# Import environment variables
if [[ -f ${HOME}/.config/shell/environment/common_env ]]; then
  . ${HOME}/.config/shell/environment/common_env
fi

# Import custom functions into the session
if [[ -f ${HOME}/.config/shell/functions/bash_functions.sh ]]; then
  . ${HOME}/.config/shell/functions/bash_functions.sh
fi

if [[ -f ${HOME}/.config/shell/functions/common_functions.sh ]]; then
  source ${HOME}/.config/shell/functions/common_functions.sh
fi

if [[ -f ${HOME}/.config/shell/functions/vardump.sh ]]; then
  source ${HOME}/.config/shell/functions/vardump.sh
fi

# Import aliases into the session
if [[ -f ${HOME}/.config/shell/aliases/common_aliases ]]; then
  . ${HOME}/.config/shell/aliases/common_aliases
fi

# Set the shell prompt
if [[ -f ${HOME}/.config/shell/prompt/bash_prompt.sh ]]; then
  . ${HOME}/.config/shell/prompt/bash_prompt.sh
fi

# If not running interactively, don't attach
# tmux or else WinSCP will fail to connect.
[[ $- != *i* ]] && return

# Run zoxide to assist directory traversal
eval "$(zoxide init bash --cmd cd)"

# Auto-attach tmux "Default" session
session_name="Default"
if [[ -z "$TMUX" ]]; then
  if tmux has-session -t "${session_name}" 2>/dev/null; then
    exec tmux attach-session -t "${session_name}"
  else
    exec tmux new-session -s "${session_name}"
  fi
fi

