#!/usr/bin/env bash
# Enable and start the ssh-agent process as s user service, so it does not
# run need to be run in the shell. Running in the shell config files can
# result in multiple agents running per user unless complicated checks are
# performed, which are not always reliable.
#                                                           RT, 2026-09-14
# checksums: {{ include "private_dot_config/systemd/user/ssh-agent.service" | sha256sum }} {{ include "private_dot_config/systemd/user/ssh-agent.socket" | sha256sum }}

if [ -n "$XDG_RUNTIME_DIR" ] && systemctl --user show-environment >/dev/null 2>&1; then
    systemctl --user daemon-reload
    systemctl --user enable --now ssh-agent.socket
else
    echo "user manager unavailable; enabling only" >&2
    systemctl --user enable ssh-agent.socket 2>/dev/null || true
fi
