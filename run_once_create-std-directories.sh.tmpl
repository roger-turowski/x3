#!/bin/env bash

set -e

dirs=(
  "${HOME}/.local/share/backgrounds"
  "${HOME}/.local/share/icons"
  "${HOME}/.local/share/themes"
  "${HOME}/.ssh"
  "${HOME}/Applications"
  "${HOME}/distroboxes"
  "${HOME}/Git"
  "${HOME}/Media"
  "${HOME}/Music"
  "${HOME}/Pictures"
  "${HOME}/Projects"
  "${HOME}/snap"
  "${HOME}/Templates"
  "${HOME}/Videos"
  "${HOME}/VirtualBox VMs"
  "${HOME}/Work"
)

for dir in "${dirs[@]}"; do
  if [[ ! -d "$dir" ]]; then
    mkdir -p "$dir" || exit 1
  fi
done

# Fix the permissions on the .ssh directory
chmod 700 ~/.ssh

find ~/.ssh -maxdepth 1 -type f \( -name 'id_*' -o -name 'config' \
  -o -name 'authorized_keys' -o -name '*known_hosts*' \) -exec chmod 600 {} +
